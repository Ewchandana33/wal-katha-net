---
import Posts from "@/components/Posts.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Pagination from "@/layouts/components/Pagination.astro";
import FeaturedSlider from "@/layouts/components/FeaturedSlider.astro";
import AdsterraBanner from "@/layouts/components/AdsterraBanner.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { withTrailingSlash } from "@/lib/utils/urlHelper";

// HTML PAGE SIZE FIX: the large :global(...) CSS block that used to live
// inline here now lives in src/styles/index-overrides.css and is imported
// as a static asset, so Vite extracts it into a hashed, cacheable file.
import "@/styles/index-overrides.css";

// social.json powers the Organization "sameAs" array below.
import social from "@/config/social.json";

const posts = await getSinglePage("posts");
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPosts = sortedPosts.slice(0, config.settings.pagination);

const base_url = (config?.site?.base_url || "").replace(/\/$/, "");

// CANONICAL TRAILING-SLASH FIX. Base.astro's ensureTrailingSlash() checks
// whether the last path segment contains a dot to detect file-like URLs.
// For a bare origin ("https://www.walakatha.net") that last segment is
// "www.walakatha.net", which DOES contain dots, so the helper treated the
// homepage as a file and returned it unslashed. Cloudflare Pages then
// 308-redirects "/" requests, and the canonical tag disagreed with the
// sitemap entry (which is "https://www.walakatha.net/"). Passing an
// already-slashed URL makes the helper a no-op and keeps canonical,
// og:url and sitemap byte-for-byte identical.
const canonicalUrl = `${base_url}/`;

// Use the purpose-built homepage social image and declare its real dimensions.
const ogImage = config.metadata.meta_image;

import menu from "@/config/menu.json";

function buildNavItems(base: string) {
  const items: { name: string; url: string }[] = [];
  for (const item of menu.main || []) {
    if (item.hasChildren && Array.isArray(item.children)) {
      for (const child of item.children) {
        if (child?.url) items.push({ name: child.name, url: child.url });
      }
    } else if (item?.url) {
      items.push({ name: item.name, url: item.url });
    }
  }
  return items.map((navItem) => {
    const fullUrl = `${base}${withTrailingSlash(navItem.url)}`;
    return {
      "@type": "SiteNavigationElement",
      "@id": `${fullUrl}#navitem-${navItem.name.toLowerCase().replace(/\s+/g, "-")}`,
      "name": navItem.name,
      "url": fullUrl,
      "isPartOf": { "@id": `${base}/#website` },
    };
  });
}

const navigationSchema = buildNavItems(base_url);

const organizationSameAs = (social?.main || [])
  .map((s: any) => s?.link)
  .filter((link: any): link is string => {
    if (!link || typeof link !== "string") return false;
    try {
      const u = new URL(link);
      return u.pathname.length > 1;
    } catch {
      return false;
    }
  });

// Lead with the exact Sinhala wording from the homepage's highest-impression
// low-CTR web query, keep the title concise, and avoid an unverified daily-update promise.
const homeTitle = "සිංහල වැල් කතා කියවන්න | Wal Katha";
const homeDescription =
  "සිංහල වැල් කතා කියවීමට Wal Katha එකතුව බලන්න. කාණ්ඩ අනුව පිරික්සා හෝ සෙවුමෙන් ඔබ කැමති කතාව තෝරාගෙන නොමිලේ කියවන්න. ඔබට ගැළපෙන කතාව මෙතැනින් සොයාගන්න.";
const homeH1 = "සිංහල වල් කතා සහ වැල් කතා";

// BRAND ENTITY FIX. Organization "name" previously reused homeTitle, i.e.
// a page title ("Wal Katha - Sinhala Wal Katha & Wela Katha") rather than
// a brand name. Google's Knowledge Graph resolves a brand entity from this
// field, so a title string there blocks clean entity consolidation. The
// brand name now comes from config.site.title and every marketing variant
// moves into alternateName, where Google expects synonyms to live.
const brandName = config?.site?.title || "Sinhala Wal Katha";
const brandAlternateNames = [
  "Wal Katha",
  "Sinhala Wal Katha",
  "Aluth Wal Katha",
  "Wala Katha",
  "Wela Katha",
  "New Sinhala Wal Katha",
  "Sinhala Wela Katha",
  "Wal Katha New",
  "Aluth Sinhala Wal Katha",
  "සිංහල වල් කතා",
];

const homePageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${base_url}/#website`,
      "url": canonicalUrl,
      "name": homeTitle,
      "alternateName": brandAlternateNames,
      "description": homeDescription,
      "inLanguage": "si",
      "publisher": { "@id": `${base_url}/#organization` },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${base_url}/search/?q={search_term_string}`
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": `${base_url}/#organization`,
      "name": brandName,
      "alternateName": brandAlternateNames,
      "url": canonicalUrl,
      "description": homeDescription,
      // E-E-A-T: a reachable contact point is one of the trust signals
      // Google documents for publisher entities. Values come from
      // config.json so there is a single source of truth.
      ...(config?.contactinfo?.email
        ? {
            "contactPoint": {
              "@type": "ContactPoint",
              "contactType": "customer support",
              "email": config.contactinfo.email,
              "availableLanguage": ["Sinhala", "English"]
            }
          }
        : {}),
      ...(organizationSameAs.length > 0 ? { "sameAs": organizationSameAs } : {})
    },
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#collection`,
      "url": canonicalUrl,
      "name": homeTitle,
      "description": homeDescription,
      "inLanguage": "si",
      "isPartOf": { "@id": `${base_url}/#website` },
      "about": { "@type": "Thing", "name": "Sinhala Wal Katha Literature" },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["#speakable-home-heading"]
      }
    },
    ...navigationSchema
  ]
};
---

<Base 
  title={homeTitle}
  meta_title={homeTitle}
  description={homeDescription}
  canonical={canonicalUrl}
  image={ogImage}
  imageWidth={1024}
  imageHeight={541}
  showBottomAd={false}
>
  {/* DUPLICATE META REMOVED. Base.astro already emits og:type, og:title,
      og:description, og:url, og:image, twitter:card, twitter:title,
      twitter:description, twitter:image and robots for every non-article
      page (isArticle defaults to false). This file used to re-emit all ten
      inside a head slot, so the homepage shipped two of each - including
      two conflicting <meta name="robots"> tags. Only og:image:alt is kept
      below, since Base does not emit that one. */}
  <Fragment slot="head">
    <meta property="og:image:alt" content={homeTitle} />
    <meta name="twitter:image:alt" content={homeTitle} />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(homePageSchema)} />

  <!--
    Inner <main> tag intentionally absent to avoid a nested main > main
    structure (Base.astro already renders <main id="main-content">), which
    previously made Rich Results Test report "No items detected".
  -->
  <div class="section pt-4 pb-12 min-h-screen bg-[#050505] text-slate-200 antialiased">
    <div class="container">

      <h1 id="speakable-home-heading" class="home-title mb-4">
        <span class="home-title__text">
          {homeH1}
        </span>
        <svg
          class="home-title__ornament"
          viewBox="0 0 1200 180"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <linearGradient
              id="home-title-vine-stroke"
              x1="0"
              y1="0"
              x2="1"
              y2="1"
            >
              <stop offset="0%" stop-color="#A2E088" />
              <stop offset="52%" stop-color="#3C7B42" />
              <stop offset="100%" stop-color="#153C1D" />
            </linearGradient>
            <linearGradient
              id="home-title-leaf-fill"
              x1="0"
              y1="0"
              x2="1"
              y2="1"
            >
              <stop offset="0%" stop-color="#B7EE91" />
              <stop offset="45%" stop-color="#4F9A48" />
              <stop offset="100%" stop-color="#123B1C" />
            </linearGradient>
          </defs>
          <g class="home-title__sprig">
            <path
              class="home-title__vine"
              stroke="url(#home-title-vine-stroke)"
              d="M14 132 C47 111 62 121 83 113 C105 104 97 85 119 77 C140 69 159 93 179 91 C204 89 211 67 242 63"
            />
            <path
              class="home-title__vine"
              stroke="url(#home-title-vine-stroke)"
              d="M119 77 C131 66 133 54 126 44 C121 37 112 39 111 46 C110 52 117 54 120 50"
            />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M55 120 C42 101 48 83 68 73 C79 93 74 111 55 120Z"
            />
            <path class="home-title__vein" d="M55 118 C60 101 63 88 67 77" />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M105 88 C103 67 116 53 139 51 C140 73 128 86 105 88Z"
            />
            <path class="home-title__vein" d="M107 86 C119 72 128 61 137 54" />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M166 91 C176 70 198 64 218 72 C207 91 189 99 166 91Z"
            />
            <path class="home-title__vein" d="M169 91 C186 83 199 77 215 73" />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M221 69 C218 48 232 33 253 31 C254 52 242 67 221 69Z"
            />
            <path class="home-title__vein" d="M223 67 C235 53 244 42 251 34" />
          </g>
          <g
            class="home-title__sprig"
            transform="translate(1200 0) scale(-1 1)"
          >
            <path
              class="home-title__vine"
              stroke="url(#home-title-vine-stroke)"
              d="M14 132 C47 111 62 121 83 113 C105 104 97 85 119 77 C140 69 159 93 179 91 C204 89 211 67 242 63"
            />
            <path
              class="home-title__vine"
              stroke="url(#home-title-vine-stroke)"
              d="M119 77 C131 66 133 54 126 44 C121 37 112 39 111 46 C110 52 117 54 120 50"
            />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M55 120 C42 101 48 83 68 73 C79 93 74 111 55 120Z"
            />
            <path class="home-title__vein" d="M55 118 C60 101 63 88 67 77" />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M105 88 C103 67 116 53 139 51 C140 73 128 86 105 88Z"
            />
            <path class="home-title__vein" d="M107 86 C119 72 128 61 137 54" />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M166 91 C176 70 198 64 218 72 C207 91 189 99 166 91Z"
            />
            <path class="home-title__vein" d="M169 91 C186 83 199 77 215 73" />
            <path
              class="home-title__leaf"
              fill="url(#home-title-leaf-fill)"
              d="M221 69 C218 48 232 33 253 31 C254 52 242 67 221 69Z"
            />
            <path class="home-title__vein" d="M223 67 C235 53 244 42 251 34" />
          </g>
        </svg>
      </h1>

      <FeaturedSlider />
      <AdsterraBanner />

      <Posts posts={currentPosts} className="mb-16" />
      
      <Pagination currentPage={1} totalPages={totalPages} />
      
    </div>
  </div>

</Base>