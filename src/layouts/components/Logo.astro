---
import config from "@/config/config.json";

const brandName = config.site.logo_text || "Wal Katha";
---

<div itemscope itemtype="https://schema.org/Organization" class="inline-block">
  <a
    href="/"
    class="navbar-brand block transition-all duration-300 hover:opacity-90"
    itemprop="url"
  >
    <span class="navbar-brand-text" itemprop="name">{brandName}</span>
  </a>
</div>
