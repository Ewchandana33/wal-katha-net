# Early Hints: per-post hero-image "Link: rel=preload" rules are appended to
# dist/_headers (build output) by src/integrations/early-hints-preload.mjs.
# Cloudflare replays them as HTTP 103 once Early Hints is enabled for the zone.
#
# 2026-09: connect-src now also allows https://translate.googleapis.com.
# The reader tools "voice" tab uses it to translate the article chunk by
# chunk when a non-Sinhala reading language is selected. Remove this entry
# if that fallback is ever dropped from reader-tools.js.
#
# Adsterra banner scripts are loaded only after the age gate is dismissed.
# The only external script origin used by the supplied banner unit is
# allowlisted below; frame-src permits the HTTPS creative iframe.
#
# frame-src remains "https:" wildcard (not a fixed domain list), which
# covers the ad-creative iframe without needing a maintained frame
# allowlist. media-src stays "https:" for the same reason.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://deliberatewatchful.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://comments.wala-katha.workers.dev https://api.web3forms.com https://cloudflareinsights.com https://translate.googleapis.com; media-src 'self' https: blob:; frame-src 'self' https:; frame-ancestors 'self'

# Cache lifetimes for assets served from our own origin. Astro hashes JS/CSS
# bundle filenames and site images never change in place (optimize-images.yml
# rewrites a .webp only when its content changes), so a one-year immutable
# cache is safe. The Cloudflare beacon script comes from
# static.cloudflareinsights.com and its cache lifetime cannot be set here.
#
# The footer "Watch Movies" popup opens teraboxpage.com in a new tab (its own
# X-Frame-Options blocks iframes), so it needs no frame-src allowance of its
# own - the frame-src added above exists solely to support ad creative
# iframes, which is a separate, unrelated concern from this popup.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# Reader copies of canonical articles are for offline use, not search landing pages.
/downloads/*.pdf
  Content-Type: application/pdf
  Content-Disposition: attachment
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=86400

/downloads/*.md
  Content-Type: text/markdown; charset=utf-8
  Content-Disposition: attachment
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=86400
